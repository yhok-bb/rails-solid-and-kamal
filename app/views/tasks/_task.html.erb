<div id="<%= dom_id task %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= task.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Body:</strong>
    <%= task.body %>
  </div>
  <% if task.image.attached? %>
    <div>
      <strong class="block font-medium mb-1">Image:</strong>
      <%= image_tag task.image, class: "max-w-sm" %>
    </div>
  <% end %>
</div>
